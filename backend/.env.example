APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Canonical React SPA URL, used to build links opened in the browser (password resets, invites).
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with credentials (the React app).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated hosts (no scheme) that receive Sanctum's stateful SPA auth cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/dev default is SQLite (zero setup). For production, switch to MySQL:
# DB_CONNECTION=mysql, then uncomment and fill in the values below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=school_management_system
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys) — platform
# subscription billing for tenant schools (Phase 6), NOT the school-to-parent
# fee billing planned for a later phase. STRIPE_WEBHOOK_SECRET comes from
# `stripe listen --forward-to http://localhost:8000/stripe/webhook` in local
# dev, or the endpoint's signing secret in the Stripe dashboard in production.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

VITE_APP_NAME="${APP_NAME}"
