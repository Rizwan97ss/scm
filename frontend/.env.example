# Base URL of the Laravel API (no trailing slash). The SPA calls {VITE_API_URL}/v1/...
# and fetches the CSRF cookie from {origin of VITE_API_URL}/sanctum/csrf-cookie.
VITE_API_URL=http://localhost:8000/api

# Fallback app name shown before /settings/public has loaded (School Admin can
# override the real name via Settings > Branding once the app boots).
VITE_APP_NAME="School Management System"
